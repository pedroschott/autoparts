# AgentPay merchant integration.
# Neither value is a secret: every check the SDK makes is cryptographic or public.
AGENTPAY_MERCHANT_ID=mrc_835dda9e14b9709870f2
AGENTPAY_REGISTRY_URL=https://agentpay-yuno.vercel.app

# Currency PartsRoute quotes agents. The mandate must be denominated in the same
# currency or the policy engine refuses with CURRENCY_MISMATCH — it converts
# nothing. Buyers hold BRL mandates today, so the storefront's USD prices are
# converted at the published rate below before they are quoted.
AGENTPAY_CURRENCY=BRL
AGENTPAY_FX_RATE_FROM_USD=5.40
